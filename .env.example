# Data source: "mock" for local demo data, "supabase" for a configured backend.
VITE_DATA_MODE=mock

# Canonical public URL used for metadata, sitemap, and share links.
VITE_SITE_URL=http://localhost:5173

# Public Supabase values. Leave empty while VITE_DATA_MODE=mock.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public CAPTCHA site key. Its secret belongs in Supabase Function secrets.
VITE_TURNSTILE_SITE_KEY=

# Analytics stays disabled until a provider and privacy policy are approved.
VITE_ANALYTICS_PROVIDER=disabled
VITE_ANALYTICS_SITE_ID=

